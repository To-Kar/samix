# Optional. The core works without this file: with DATABASE_URL unset it uses
# core/data/samix-dev.db and applies migrations itself at start.
#
# Only needed to point the Prisma CLI (db:migrate, db:studio) at a database.
# Relative paths resolve against core/prisma/, so use an absolute path:
# DATABASE_URL="file:/absolute/path/to/samix.db"
