generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id        String   @id @default(uuid())
  slug      String   @unique
  type      String
  skillPath String
  config    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs   AgentRun[]
  budget BudgetLedger[]
}

model AgentRun {
  id           String    @id @default(uuid())
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id])
  status       String
  trigger      String
  input        String?
  output       String?
  tokensInput  Int       @default(0)
  tokensOutput Int       @default(0)
  costUsd      Float     @default(0)
  error        String?
  // The adapter that actually served the call (may be the fallback).
  model        String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  articles  Article[]
  snapshots SourceSnapshot[]

  @@index([agentId, startedAt])
}

model Article {
  id          String    @id @default(uuid())
  agentRunId  String
  agentRun    AgentRun  @relation(fields: [agentRunId], references: [id])
  title       String
  summary     String
  sourceUrl   String?
  sourceName  String?
  publishedAt DateTime?
  topic       String?
  metadata    String?
  // 1 (filler) .. 5 (lead story), as judged by the model; shown to the user
  // together with the reason.
  importance       Int?
  importanceReason String?
  createdAt   DateTime  @default(now())

  content ArticleContent?

  @@index([topic, createdAt])
}

// Full text of the linked page, extracted locally (no LLM involved) and
// cached. `blocks` is a JSON array of structured blocks, never raw HTML.
model ArticleContent {
  id             String   @id @default(uuid())
  articleId      String   @unique
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // ok | unsupported | failed. `error` carries the specific reason.
  status         String
  error          String?
  finalUrl       String?
  title          String?
  byline         String?
  siteName       String?
  lang           String?
  leadImageId    String?
  blocks         String   @default("[]")
  wordCount      Int      @default(0)
  readingMinutes Int      @default(0)
  fetchedAt      DateTime @default(now())
}

model BudgetLedger {
  id           String   @id @default(uuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  period       DateTime
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  costUsd      Float    @default(0)

  @@unique([agentId, period])
}

model SourceSnapshot {
  id          String    @id @default(uuid())
  agentRunId  String
  agentRun    AgentRun  @relation(fields: [agentRunId], references: [id])
  sourceType  String
  sourceName  String
  url         String
  title       String
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  raw         String?

  @@index([agentRunId])
  @@index([url])
}

